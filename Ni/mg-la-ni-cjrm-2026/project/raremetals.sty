\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{raremetals}[2026/09/07 Unofficial Word-template migration profile]

\RequirePackage{iftex}
\ifXeTeX\else
  \PackageError{raremetals}{This migration profile requires XeLaTeX}{Set engine to xelatex.}
\fi
\RequirePackage{fontspec}
\RequirePackage{geometry}
\RequirePackage{setspace}
\RequirePackage{caption}
\RequirePackage{booktabs}
\RequirePackage{graphicx}
\RequirePackage{hyperref}
\RequirePackage[numbers,sort&compress]{natbib}

% Times New Roman has no glyph for the single Unicode Celsius character U+2103.
% Keep source text readable while typesetting it as a degree sign plus upright C.
\catcode`℃=\active
\protected\def℃{\ensuremath{{}^{\circ}\mathrm{C}}}

% Use the conventional A4 manuscript canvas and a moderately wider text block.
% The retained source template is Word-based and year-unverified, so these
% values are a compact working layout rather than a claim of journal compliance.
\geometry{a4paper,top=20mm,bottom=20mm,left=22mm,right=22mm,headsep=5mm,footskip=10mm}
\IfFontExistsTF{Times New Roman}{\setmainfont{Times New Roman}}{}
\IfFontExistsTF{Songti SC}{\setCJKmainfont{Songti SC}}{}
\IfFontExistsTF{Heiti SC}{\setCJKsansfont{Heiti SC}}{}
\setlength{\parindent}{2em}
\setlength{\parskip}{0pt}
\setlength{\bibsep}{0pt}
\setstretch{1.0}
\setlength{\textfloatsep}{8pt plus 2pt minus 2pt}
\setlength{\floatsep}{7pt plus 2pt minus 2pt}
\setlength{\intextsep}{7pt plus 2pt minus 2pt}
\setlength{\@fpsep}{8pt plus 2pt minus 2pt}
\setlength{\abovedisplayskip}{7pt plus 2pt minus 2pt}
\setlength{\belowdisplayskip}{7pt plus 2pt minus 2pt}
\setlength{\abovedisplayshortskip}{4pt plus 2pt minus 1pt}
\setlength{\belowdisplayshortskip}{4pt plus 2pt minus 1pt}
\setlength{\emergencystretch}{1em}
\hypersetup{hidelinks}

\ctexset{
  section={format=\normalfont\fontsize{14}{17}\selectfont,beforeskip=6pt,afterskip=4pt},
  subsection={format=\bfseries\fontsize{10.5}{17}\selectfont,beforeskip=4pt,afterskip=2pt},
  subsubsection={format=\normalfont\fontsize{10.5}{17}\selectfont,beforeskip=3pt,afterskip=2pt}
}
\captionsetup{font=small,labelfont=bf,justification=centering,singlelinecheck=false,skip=3pt}
\renewcommand{\figurename}{图}
\renewcommand{\tablename}{表}

\newcommand{\RMTitleCN}[1]{\def\rm@titlecn{#1}}
\newcommand{\RMAuthorCN}[1]{\def\rm@authorcn{#1}}
\newcommand{\RMAffiliationCN}[1]{\def\rm@affiliationcn{#1}}
\newcommand{\RMAbstractCN}[1]{\def\rm@abstractcn{#1}}
\newcommand{\RMKeywordsCN}[1]{\def\rm@keywordscn{#1}}
\newcommand{\RMClassification}[1]{\def\rm@classification{#1}}
\newcommand{\RMTitleEN}[1]{\def\rm@titleen{#1}}
\newcommand{\RMAuthorEN}[1]{\def\rm@authoren{#1}}
\newcommand{\RMAffiliationEN}[1]{\def\rm@affiliationen{#1}}
\newcommand{\RMAbstractEN}[1]{\def\rm@abstracten{#1}}
\newcommand{\RMKeywordsEN}[1]{\def\rm@keywordsen{#1}}
\newcommand{\RMFunding}[1]{\def\rm@funding{#1}}
\newcommand{\RMAuthorBio}[1]{\def\rm@authorbio{#1}}
\newcommand{\RMCorrespondingAuthor}[1]{\def\rm@corresponding{#1}}

\newcommand{\makermfrontmatter}{%
  \begin{center}
    {\bfseries\fontsize{20}{23}\selectfont \rm@titlecn\par}
    \vspace{5pt}
    {\fontsize{13}{16}\selectfont \rm@authorcn\par}
    {\fontsize{10.5}{14}\selectfont \rm@affiliationcn\par}
  \end{center}
  \vspace{3pt}
  {\fontsize{9}{15}\selectfont\noindent\textbf{摘要：}\rm@abstractcn\par}
  {\fontsize{9}{15}\selectfont\noindent\textbf{关键词：}\rm@keywordscn\par}
  {\fontsize{9}{15}\selectfont\noindent\textbf{中图分类号：}\rm@classification\quad
   \textbf{文献标识码：}【编辑部填写】\quad\textbf{文章编号：}【编辑部填写】\par}
  \vspace{3pt}
}

\newcommand{\makermenglish}{%
  \clearpage
  {\bfseries\fontsize{16}{18}\selectfont\noindent\rm@titleen\par}
  {\fontsize{10.5}{15}\selectfont\noindent\rm@authoren\par}
  {\itshape\fontsize{10.5}{15}\selectfont\noindent\rm@affiliationen\par}
  {\fontsize{9}{15}\selectfont\noindent\textbf{Abstract: }\rm@abstracten\par}
  {\fontsize{9}{15}\selectfont\noindent\textbf{Key words: }\rm@keywordsen\par}
}

\newcommand{\makermmetadata}{%
  \vspace{5pt}
  {\fontsize{7.5}{11}\selectfont
    \noindent\textbf{基金项目：}\rm@funding\par
    \noindent\textbf{作者简介：}\rm@authorbio\par
    \noindent\textbf{通信作者：}\rm@corresponding\par}
}

\newcommand{\bilingualcaption}[2]{\caption{#1\\[1pt]#2}}
\newenvironment{rmreferences}{\begingroup\fontsize{7.5}{12.5}\selectfont}{\endgroup}

\AtBeginDocument{\pagestyle{plain}\fontsize{10.5}{17}\selectfont}
